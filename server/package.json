{
  "name": "gpss-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "build": "tsc && node scripts/copyProcessTemplates.mjs",
    "start": "NODE_ENV=production node dist/index.js",
    "start:dev": "NODE_ENV=development tsx src/index.ts",
    "db:init": "tsx src/scripts/initDb.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:bootstrap-admin": "tsx src/scripts/bootstrapAdmin.ts",
    "db:migrate-process": "tsx src/scripts/migrateAddProcessStages.ts",
