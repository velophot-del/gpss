# 应用监听
PORT=3001
HOST=127.0.0.1

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=gpss_db
USE_SOCKET=false
DB_SOCKET_PATH=/tmp/mysql.sock
DB_CREATE_IF_MISSING=false

# JWT 密钥（生产环境请更换为随机字符串）
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
ENABLE_DEMO_LOGIN=false

# 前端地址（CORS）
FRONTEND_URL=http://127.0.0.1:3001

# 文件上传目录
UPLOAD_DIR=./uploads
