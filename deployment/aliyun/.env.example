# 阿里云 ECS 用环境变量示例
# 1) 复制为 .env
# 2) 按实际值修改以下内容

COMPOSE_PROJECT_NAME=gpss
TZ=Asia/Shanghai

PUBLIC_URL=http://your-aliyun-ip
HTTP_PORT=80
HTTPS_PORT=443

DB_NAME=gpss
DB_USER=gpss
DB_PASSWORD=ChangeMeStrongPassword123!
MYSQL_ROOT_PASSWORD=RootStrongPassword456!

JWT_SECRET=replace_with_a_strong_random_secret
JWT_EXPIRES_IN=7d

ENABLE_DEMO_LOGIN=false
